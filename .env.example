# AURA — Environment Configuration Template
# Copy this file to .env (root or backend/.env) and populate your keys.
# NEVER commit .env with real credentials to source control.

# --- Multimodal AI & LLM Reasoning ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
VISION_PROVIDER=auto

# --- Backend Server Configuration ---
PORT=8000
HOST=0.0.0.0
DEBUG=false
MAX_UPLOAD_SIZE_MB=50

# --- Database Configuration (PostgreSQL 16 + pgvector / Local SQLite) ---
DATABASE_URL=postgresql+asyncpg://aura_user:aura_secure_password@localhost:5432/aura_db
USE_PGVECTOR=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Frontend Client Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

